---
import site from '../data/site.json';
import { getT, type Lang } from '../i18n/utils';
const { lang = 'fr' } = Astro.props as { lang?: Lang };
const t = getT(lang);
---
<footer class="mt-24 bg-nuit text-white/80">
  <div class="mx-auto grid max-w-6xl gap-6 px-6 py-10 text-sm md:grid-cols-2">
    <div>
      <p class="font-serif text-lg text-white">{site.name}</p>
      <p>{t.footer.rights} · RNA {site.rna}</p>
      <p>{site.address}</p>
    </div>
    <ul class="flex gap-6 md:justify-end">
      <li><a href="/mentions-legales" class="underline">{t.footer.legal}</a></li>
      <li><a href="/confidentialite" class="underline">{t.footer.privacy}</a></li>
      <li><a href={`mailto:${site.email}`} class="underline">{site.email}</a></li>
    </ul>
  </div>
</footer>
